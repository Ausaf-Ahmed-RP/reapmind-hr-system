# ReapMind HR System - Apache Configuration
# Suitable for Cloudways LAMP/LEMP stacks

Options -Indexes
ServerSignature Off

# UTF-8 Encoding
AddDefaultCharset UTF-8

# Prevent directory listings
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Protect sensitive files and directories
<FilesMatch "^\.|\.sql$|\.env$|\.git">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Security: Disallow execution of scripts inside uploads folder
<Directory "uploads">
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|cgi|pl)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</Directory>

# Rewrite Rules for default index
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>
