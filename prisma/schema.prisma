datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String              @id @default(cuid())
  name                String
  email               String              @unique
  role                String              // "FRONT_DESK", "HR", "DIRECTOR", "CEO", "ADMIN"
  passwordHash        String
  mobile              String?
  isActive            Boolean             @default(true)
  is2FAEnabled        Boolean             @default(false)
  forcePasswordChange Boolean             @default(false)
  lastLogin           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  uploadedCandidates  Candidate[]         @relation("UploadedBy")
  assignedCandidates  Candidate[]         @relation("AssignedTo")
  assignmentsMade     Assignment[]        @relation("AssignedBy")
  assignmentsReceived Assignment[]        @relation("AssignedToUser")
  feedbacks           InterviewFeedback[] @relation("Interviewer")
  notifications       Notification[]
  auditLogs           AuditLog[]
}

model Candidate {
  id           String              @id @default(cuid())
  candidateId  String              @unique // e.g. RM-CAN-000101
  fullName     String
  mobile       String
  email        String
  position     String
  source       String              // Walk-in, Referral, Job portal, Consultant, Other
  status       String              @default("New") // New, Assigned, Interview Pending, Interviewed, Shortlisted, On Hold, Rejected
  remarks      String?
  consentFlag  Boolean             @default(true)
  
  uploadedById String
  uploadedBy   User                @relation("UploadedBy", fields: [uploadedById], references: [id])
  
  assignedToId String?
  assignedTo   User?               @relation("AssignedTo", fields: [assignedToId], references: [id])

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  files        CandidateFile[]
  assignments  Assignment[]
  feedbacks    InterviewFeedback[]
  notifications Notification[]
}

model CandidateFile {
  id              String    @id @default(cuid())
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fileType        String    // "RESUME", "CAMERA_PAGE", "DOCUMENT"
  storagePath     String
  fileName        String
  mimeType        String
  fileSize        Int
  pageNumber      Int?
  uploadedById    String
  virusScanStatus String    @default("CLEAN")
  fileData        Bytes?
  createdAt       DateTime  @default(now())
}

model Assignment {
  id                String    @id @default(cuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assignedToId      String
  assignedTo        User      @relation("AssignedToUser", fields: [assignedToId], references: [id])
  assignedById      String
  assignedBy        User      @relation("AssignedBy", fields: [assignedById], references: [id])
  round             String    @default("Screening") // Screening, Technical, HR, Final
  interviewDatetime DateTime?
  assignedAt        DateTime  @default(now())
}

model InterviewFeedback {
  id              String            @id @default(cuid())
  candidateId     String
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewerId   String
  interviewer     User              @relation("Interviewer", fields: [interviewerId], references: [id])
  interviewerName String
  round           String            // Screening, Technical, HR, Final
  interviewDate   DateTime          @default(now())
  rating          Int               // 1 to 5
  recommendation  String            // Select, Hold, Reject, Next round
  comments        String            // min 20 chars
  strengths       String?
  concerns        String?
  expectedCtc     String?
  noticePeriod    String?
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  editedAt        DateTime?

  versions        FeedbackVersion[]
}

model FeedbackVersion {
  id               String            @id @default(cuid())
  feedbackId       String
  feedback         InterviewFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  versionNumber    Int
  previousComments String
  editedById       String
  editedAt         DateTime          @default(now())
}

model Notification {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String     // NEW_CANDIDATE, ASSIGNED, FEEDBACK, STATUS_CHANGE
  read        Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName  String?
  action    String   // LOGIN, CANDIDATE_INTAKE, RESUME_VIEW, RESUME_DOWNLOAD, ASSIGNMENT, FEEDBACK_ADDED, FEEDBACK_EDITED, STATUS_CHANGED, USER_MANAGED, SETTINGS_CHANGED
  entity    String   // Candidate, Feedback, User, Settings
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model MasterList {
  id        String   @id @default(cuid())
  category  String   // POSITION, SOURCE, STATUS, ROUND
  label     String
  value     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
